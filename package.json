{
  "name": "aurora-like",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A prototype 4X strategy game in the spirit of Aurora 4X - the dawn of the trans-Newtonian age.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "esbuild tools/sanity.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/sanity.mjs --log-level=warning && node node_modules/.cache/sanity.mjs",
    "ui": "node tools/ui-test.mjs",
    "theme": "esbuild tools/make-theme.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/make-theme.mjs --log-level=warning && node node_modules/.cache/make-theme.mjs",
    "bench": "esbuild tools/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=warning && node node_modules/.cache/bench.mjs",
    "techs": "esbuild tools/build-techs.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/build-techs.mjs --log-level=warning && node node_modules/.cache/build-techs.mjs",
    "techs:flows": "esbuild tools/techs-to-flyde.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/techs-to-flyde.mjs --log-level=warning && node node_modules/.cache/techs-to-flyde.mjs"
  },
  "devDependencies": {
    "@flyde/core": "^1.0.46",
    "@flyde/loader": "^1.0.46",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
